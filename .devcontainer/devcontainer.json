{
  "name": "Jekyll Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",

  "runArgs": [
    "-v",
    "${localWorkspaceFolder}:/workspace:Z"
  ],
  
  "extensions": [
    "ms-vscode.cpptools",
    "ms-vscode.cmake-tools"
  ],
  "postCreateCommand": "bundle install",
  "postStartCommand": "bundle exec jekyll serve --host 0.0.0.0 --port 4000",
  "forwardPorts": [4000],
  "remoteUser": "root"
}